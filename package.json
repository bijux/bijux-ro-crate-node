{
  "name": "bijux-ro-crate-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/workspaces.mjs test && node --test tests/parity/comparator.test.mjs tests/standards/admission.test.mjs tests/browser/file-access.test.mjs",
    "check:workspace": "node scripts/workspaces.mjs check",
    "pretest": "npm run build",
    "test:parity": "node tests/parity/run.mjs",
    "test:oracle": "node tests/parity/run.mjs --oracle-only",
    "check:types": "node scripts/typecheck.mjs",
    "test:browser": "node tests/browser/parity.mjs",
    "test:live": "node tests/browser/repair.mjs",
    "test:workload": "node tests/browser/workloads.mjs",
    "test:pack": "npm run build && node scripts/release/pack.mjs && node tests/package/consumers.mjs",
    "test:workspace": "npm run check:workspace && npm run test:pack",
    "example": "npm run build && node scripts/http/example.mjs",
    "postinstall": "patch-package --patch-dir scripts/dependencies/patches --error-on-fail"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@xmldom/xmldom": "0.9.12",
    "decimal.js": "10.6.0",
    "esbuild": "0.25.12",
    "jsonld": "9.0.0",
    "parse5": "8.1.1",
    "patch-package": "8.0.1",
    "playwright": "1.64.1",
    "rdf-validate-shacl": "0.6.5",
    "typescript": "5.9.3"
  }
}

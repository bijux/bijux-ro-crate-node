{
  "name": "bijux-ro-crate-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test packages/core/tests/*.test.mjs tests/functional/*.test.mjs tests/parity/comparator.test.mjs",
    "check:workspace": "node scripts/workspaces.mjs check",
    "pretest": "npm run build",
    "test:parity": "node tests/parity/run.mjs",
    "test:oracle": "node tests/parity/run.mjs --oracle-only",
    "check:types": "node scripts/typecheck.mjs",
    "test:browser": "node tests/browser/parity.mjs",
    "test:live": "node tests/browser/repair.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "jsonld": "9.0.0",
    "playwright": "1.64.1",
    "rdf-validate-shacl": "0.6.5",
    "typescript": "5.9.3"
  }
}

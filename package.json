{
  "name": "bijux-ro-crate-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/workspaces.mjs test && node scripts/testing/root-tests.mjs",
    "test:tooling": "node scripts/testing/root-tests.mjs --scope tooling",
    "check:test-selection": "node scripts/testing/root-tests.mjs --audit",
    "check:workspace": "node scripts/workspaces.mjs check && npm run check:boundaries",
    "check:boundaries": "node scripts/testing/boundaries.mjs",
    "pretest": "npm run build",
    "test:parity": "node scripts/parity.mjs",
    "test:oracle": "node tests/parity/run.mjs --oracle-only",
    "check:types": "node scripts/typecheck.mjs",
    "generate:admission": "node --import tsx scripts/generate-runtime-entries.mts --write admission",
    "generate:runtime": "node --import tsx scripts/generate-runtime-entries.mts --write",
    "test:browser": "node tests/browser/parity.mjs",
    "test:live": "node tests/browser/repair.mjs",
    "test:workload": "node tests/browser/workloads.mjs",
    "test:pack": "npm run build && node scripts/release/pack.mjs && node tests/package/consumers.mjs",
    "test:workspace": "npm run check:workspace && npm run test:pack",
    "example": "npm run build && node scripts/http/example.mjs",
    "postinstall": "patch-package --patch-dir scripts/dependencies/patches --error-on-fail",
    "docs:build": "node --import tsx scripts/docs/build.mts",
    "docs:serve": "python3 -m http.server --bind 127.0.0.1 --directory artifacts/documentation/site ${DOCS_PORT:-4173}",
    "predocs:serve": "npm run docs:build"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@xmldom/xmldom": "0.9.12",
    "decimal.js": "10.6.0",
    "esbuild": "0.25.12",
    "jsonld": "9.0.0",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.1.0",
    "parse5": "8.1.1",
    "patch-package": "8.0.1",
    "playwright": "1.64.1",
    "rdf-validate-shacl": "0.6.5",
    "tr46": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "whatwg-url": "14.1.0"
  }
}

{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.astro",
    "astro.config.ts",
    "boundaries.ts",
    "source-admission.ts",
    "dev.mts"
  ],
  "vueCompilerOptions": {
    "strictTemplates": true
  }
}

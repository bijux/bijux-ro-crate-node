{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.astro",
    "astro.config.ts",
    "boundaries.ts",
    "source-admission.ts"
  ]
}

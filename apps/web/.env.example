# Standalone runs without a BSS connection.
BSS_MODE=standalone
# For local integration, set BSS_MODE=local and supply the existing API prefix.
# BSS_API_BASE_URL=http://127.0.0.1:8000/api/v0
# For an explicitly configured container service, set BSS_LOCAL_SERVICE_HOST.
# A connected endpoint must use HTTPS. This placeholder does not enable or
# qualify authentication, submissions, or deployment.
# BSS_MODE=connected
# BSS_API_BASE_URL=https://bss.example.invalid/api/v0
